# Telegram — @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets — compte de service, partager le Sheet en Editeur avec cet email
GOOGLE_SA_EMAIL=
# OBLIGATOIRE : la cle entre guillemets doubles, sur une seule ligne, \n litteraux
# (pas de vrais retours a la ligne). Sans les guillemets, la valeur est coupee au
# premier retour a la ligne et devient invalide sans avertissement au moment de coller.
# Exemple : GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GOOGLE_SA_PRIVATE_KEY=
SHEET_ID=
SHEET_TAB=Prospects

# Bluesky — FACULTATIF. Mot de passe d'application (pas le mot de passe du compte) :
# reglages Bluesky > Confidentialite et securite > Mots de passe d'application.
# Sans ces deux valeurs, la source Bluesky se desactive proprement (les autres sources
# continuent) : la recherche non authentifiee est fermee depuis 2026 (403 mesure).
BLUESKY_ID=
BLUESKY_APP_PASSWORD=

# Reddit — FACULTATIF, source actuellement injoignable. Reddit a ferme la creation
# d'applications en libre-service (Responsible Builder Policy, verifie le 2026-08-19 :
# reddit.com/prefs/apps refuse la creation, /new.json et /search.json renvoient 403
# meme avec un user-agent de navigateur) : une approbation ECRITE explicite est
# desormais exigee pour tout usage commercial. Sans ces trois valeurs, la source
# Reddit se desactive proprement (les autres sources continuent). Si un accord Reddit
# arrive un jour (reddit.com/prefs/apps, type "script"), coller les cles ici suffit a
# reveiller la source, aucun autre changement necessaire.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=riveska-radar/0.1 by /u/TON_PSEUDO

# LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash

# Reglages
SCORE_THRESHOLD=60
MAX_POST_AGE_DAYS=30
RETENTION_DAYS=90
