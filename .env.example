# Google Sheets — compte de service, partager le Sheet en Editeur avec cet email
GOOGLE_SA_EMAIL=
# OBLIGATOIRE : la cle entre guillemets doubles, sur une seule ligne, \n litteraux
# (pas de vrais retours a la ligne). Sans les guillemets, la valeur est coupee au
# premier retour a la ligne et devient invalide sans avertissement au moment de coller.
# Exemple : GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GOOGLE_SA_PRIVATE_KEY=
SHEET_ID=
SHEET_TAB=Prospects

# LLM
