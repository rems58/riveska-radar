# Empeche npm de compiler les dependances natives depuis les sources.
#
# better-sqlite3 embarque son binaire Windows precompile (prebuilds/win32-x64.node)
# et n'a aucun script d'installation. Mais il livre aussi un binding.gyp, et npm
# lance node-gyp AUTOMATIQUEMENT des qu'il voit ce fichier sans script install.
# node-gyp reclame alors Python et les outils de build Visual Studio - plusieurs Go
# pour reconstruire un binaire deja present dans le paquet.
#
# Constate sur la machine cible (Windows 10, Node 24.19, npm 11.17) : l'installation
# echouait sur "Could not find any Python installation to use". Le comportement
# depend de la version de npm (11.6 ne declenchait pas la compilation, 11.17 si),
# donc ce reglage protege aussi des futures machines.
#
# Sans effet sur `npm run` (verifie) : seuls les scripts de cycle de vie des
# dependances sont ignores, aucune des notres n'en a besoin.
ignore-scripts=true
